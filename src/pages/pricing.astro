---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import QuoteBuilder from "@/components/Interactive/QuoteBuilder.astro";
import { SITE_URL } from "@/consts.ts";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: SITE_URL,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Pricing",
      item: `${SITE_URL}/pricing`,
    },
  ],
};
---

<Layout
  title="Sydney Event Photography Pricing & Rates | IWEP"
  description="Sydney event photography pricing and rates across corporate conferences, charity galas, private celebrations and headshots. Calculate an estimate or request a confirmed quote."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>

  <!-- Hero Header -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">INSTANT EVENT PHOTOGRAPHY ESTIMATE</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>Sydney Event Photography Pricing & Rates</Heading>
      <Paragraph variant="large" maxWidth={38}>
        Calculate transparent event photography rates for your Sydney event. Estimates cover continuous on-site hours, full post-production colour grading, and commercial reproduction rights in perpetuity.
      </Paragraph>
    </ContentWrapper>
  </Section>

  <!-- Pricing Builder Tool -->
  <Section paddingTop="none" paddingBottom="medium">
    <ContentWrapper>
      <QuoteBuilder id="pricing-builder" />
    </ContentWrapper>
  </Section>

  <!-- How event photography pricing works -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper>
      <Eyebrow variant="tag">PRICING GUIDELINES</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={28}>How event photography pricing works</Heading>
      <Paragraph maxWidth={38}>
        Every booking includes dedicated photographic coverage, professional post-production curation, colour grading, and full commercial reproduction rights for your team in perpetuity.
      </Paragraph>

      <Grid small={1} medium={2} large={2} class="margin-top-4">
        <div>
          <Heading tag="h3" variant="h6">Sydney market rates & benchmarks</Heading>
          <Paragraph variant="small">
            Commercial event photography in Sydney typically benchmarks between $250 and $450 per hour depending on technical scale, dual-camera coverage, and delivery requirements. Our interactive builder gives you upfront cost clarity based on your schedule.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Inclusions and coverage</Heading>
          <Paragraph variant="small">
            Time is calculated continuously on site from arrival through scheduled departure. Coverage includes dual-camera capture, professional selection, and complete colour grading without per-image download fees.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Factors that adjust a quote</Heading>
          <Paragraph variant="small">
            Confirmed quotes reflect your specific run sheet. Factors that can adjust an estimate include overlapping breakout rooms, additional photographers, travel outside metropolitan Sydney, or specialised production requirements.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Turnaround and delivery</Heading>
          <Paragraph variant="small">
            Full galleries are delivered via private digital download within 3 to 5 business days. Next-day highlights and agreed same-day PR selects are available when requested and scoped before the event.
          </Paragraph>
        </div>
      </Grid>

      <ButtonWrapper marginTop="4">
        <Button element="link" href="/docs/pricing-and-rates-guide" variant="link">
          Read the complete Sydney event photography pricing and rates guide &rarr;
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Supporting Guides and Proof -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">REPRESENTATIVE CASE STUDIES</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={26}>Proven Sydney Event Coverage</Heading>
      <Paragraph maxWidth={36}>
        Explore verified coverage across corporate summits, brand activations, and foundation galas.
      </Paragraph>

      <Grid small={1} medium={3} large={3} class="margin-top-4">
        <div>
          <Heading tag="h3" variant="h6">Corporate & Conferences</Heading>
          <Paragraph variant="small">
            <a href="/galleries/echo-change-future-action-summit-2026">Echo Change Future Action Summit</a> at ICC Sydney. Plenary, keynote, and panel documentation.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Brand Activations</Heading>
          <Paragraph variant="small">
            <a href="/galleries/australian-fashion-week-2026">Australian Fashion Week</a> at Carriageworks. Pop-up spaces, designer showcases, and sponsor lounges.
          </Paragraph>
        </div>

        <div>
          <Heading tag="h3" variant="h6">Charity & Community</Heading>
          <Paragraph variant="small">
            <a href="/galleries/sony-foundation-wharf4ward">Sony Foundation Wharf4Ward</a> at Woolloomooloo. Foundation fundraising gala and live stage coverage.
          </Paragraph>
        </div>
      </Grid>

      <ButtonWrapper marginTop="4">
        <Button element="link" href="/galleries">View All Case Studies</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
