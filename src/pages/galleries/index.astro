---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import GalleryCard from "@/components/Item/GalleryCard.astro";
import {
  getGalleryCover,
  getGalleryCoverPosition,
} from "@/data/gallery-covers";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import { GALLERIES, GALLERY_CATEGORIES } from "@/data/galleries.ts";

const featuredGallery =
  GALLERIES.find((gallery) => gallery.slug === "sony-foundation-wharf4ward") ??
  GALLERIES[0];
const remainingGalleries = GALLERIES.filter(
  (gallery) => gallery.slug !== featuredGallery.slug,
);
---

<Layout
  title="Selected Work & Case Studies | Inner West Event Photography"
  description="Explore event photography across corporate conferences, charity galas, fashion runways, celebrations, concerts, and sports in Sydney."
>
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <Eyebrow variant="tag">PORTFOLIO</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={20}>Selected Work</Heading>
      <Paragraph variant="large" maxWidth={36}>
        Corporate, not-for-profit, fashion, weddings, celebrations, concerts,
        and sports photography across Sydney.
      </Paragraph>

      <ButtonWrapper marginTop="4">
        {
          GALLERY_CATEGORIES.map((category) => (
            <Button
              element="link"
              href={`/galleries/category/${category.slug}`}
              emphasis="secondary"
            >
              {category.shortName}
            </Button>
          ))
        }
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <Section paddingTop="none" paddingBottom="large">
    <ContentWrapper>
      <Grid small={1} medium={2} large={3}>
        {
          [featuredGallery, ...remainingGalleries].map((item) => (
            <GalleryCard
              headingTag="h2"
              href={`/galleries/${item.slug}`}
              title={item.title}
              meta={[item.categoryLabel, item.location]
                .filter(Boolean)
                .join(" · ")}
              image={getGalleryCover(item)}
              imagePosition={getGalleryCoverPosition(item)}
            />
          ))
        }
      </Grid>
    </ContentWrapper>
  </Section>

  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper centered={true}>
      <Heading tag="h2" variant="h2" maxWidth={24}>Planning an Event?</Heading>
      <Paragraph maxWidth={36}>
        Send the date, location, and a short brief. We will reply with
        availability and a clear quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/contact">Get a quote</Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>
