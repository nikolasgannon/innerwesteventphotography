---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/Wrapper/Section.astro";
import ContentWrapper from "@/components/Wrapper/ContentWrapper.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Grid from "@/components/Wrapper/Grid.astro";
import Card from "@/components/Item/Card.astro";
import ButtonWrapper from "@/components/Wrapper/ButtonWrapper.astro";
import Button from "@/components/Button.astro";
import {
  SERVICES,
  getServiceBySlug,
  type ServicePackage,
} from "@/data/services.ts";
import { GALLERIES, GALLERY_CATEGORIES } from "@/data/galleries.ts";
import { DOCS } from "@/data/docs.ts";
import { LOCATIONS } from "@/data/locations.ts";

export function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: ServicePackage;
}

const { slug } = Astro.params;
const service =
  Astro.props.service ?? (slug ? getServiceBySlug(slug) : undefined);

if (!service) {
  return Astro.redirect("/404");
}

// Related case studies
const matchedGalleries = GALLERIES.filter((g) =>
  service.relatedGallerySlugs.includes(g.slug),
);
const matchedCategory = GALLERY_CATEGORIES.find(
  (c) => c.matchedServiceSlug === service.slug,
);
const planningGuides = DOCS.filter(
  (guide) => guide.relatedService === service.slug,
).slice(0, 3);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `${service.title} Sydney`,
  description: service.summary,
  provider: {
    "@type": "PhotographyBusiness",
    name: "Inner West Event Photography",
    url: "https://www.innerwesteventphotography.com.au",
  },
  areaServed: {
    "@type": "City",
    name: "Sydney",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: `${service.title} Deliverables`,
    itemListElement: service.deliverables.map((d) => ({
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: d,
      },
    })),
  },
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: "https://www.innerwesteventphotography.com.au",
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Services",
      item: "https://www.innerwesteventphotography.com.au/services",
    },
    {
      "@type": "ListItem",
      position: 3,
      name: service.title,
      item: `https://www.innerwesteventphotography.com.au/services/${service.slug}`,
    },
  ],
};
---

<Layout
  title={service.seoTitle ?? `${service.title} Sydney`}
  description={service.metaDescription ?? `${service.title} in Sydney. ${service.tagline} Get in touch for a quote.`}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(serviceSchema)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbSchema)}
    />
  </Fragment>
  <!-- Hero -->
  <Section paddingTop="medium" paddingBottom="small">
    <ContentWrapper>
      <ButtonWrapper class="margin-bottom-4">
        <Button element="link" href="/services" variant="link">
          &larr; Back to All Services
        </Button>
      </ButtonWrapper>
      <Eyebrow variant="tag">SERVICE {service.number}</Eyebrow>
      <Heading tag="h1" variant="h1" maxWidth={26}>{service.title}</Heading>
      <Paragraph variant="large" maxWidth={38}>{service.tagline}</Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/pricing#pricing-builder">Estimate this coverage</Button>
        <Button
          element="link"
          href="/docs/pricing-and-rates-guide"
          variant="link"
        >
          View Pricing Guide
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>

  <!-- Detailed Scope Grid -->
  <Section paddingTop="none" paddingBottom="medium">
    <Grid small={1} medium={3}>
      <Card
        headingTag="h2"
        heading="Who It Is For"
        text={service.commissioners
          .map((c) => `<span class="meta_line">• ${c}</span>`)
          .join("")}
      />
      <Card
        headingTag="h2"
        heading="What We Photograph"
        text={service.subjects
          .map((s) => `<span class="meta_line">• ${s}</span>`)
          .join("")}
      />
      <Card
        headingTag="h2"
        heading="How You Can Use the Photos"
        text={service.businessUses
          .map((b) => `<span class="meta_line">• ${b}</span>`)
          .join("")}
      />
    </Grid>
  </Section>

  <!-- Production Workflow -->
  <Section paddingTop="medium" paddingBottom="medium" theme="dark">
    <ContentWrapper>
      <Eyebrow variant="tag">HOW WE WORK</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}
        >From Enquiry to Photos</Heading
      >
      <Paragraph maxWidth={36}>
        We agree on the coverage and delivery before you book.
      </Paragraph>
    </ContentWrapper>

    <Grid small={1} medium={2}>
      {
        service.productionStages.map((stage) => (
          <Card heading={stage.stage} text={stage.detail} theme="dark" />
        ))
      }
    </Grid>
  </Section>

  <!-- Deliverables & Turnaround -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="columns">
      <div>
        <Eyebrow variant="tag">YOUR PHOTOS</Eyebrow>
        <Heading tag="h2" variant="h2">Photos & Usage</Heading>
        <Paragraph>
          Your quote sets out the coverage, files, delivery timing and agreed
          photo usage.
        </Paragraph>
        <ul class="deliverables-list">
          {service.deliverables.map((item) => <li>{item}</li>)}
        </ul>
      </div>

      <div slot="column2">
        <Grid small={1}>
          <Card heading="Delivery Timing" text={service.turnaroundStandard} />
          <Card heading="Have a Deadline?" text={service.turnaroundFast} />
          <Card
            heading="Before You Book"
            text="Share your schedule and any specific requirements so we can confirm what is included."
          />
        </Grid>
      </div>
    </ContentWrapper>
  </Section>

  <!-- Event Galleries -->
  {
    matchedGalleries.length > 0 && (
      <Section paddingTop="medium" paddingBottom="medium">
        <ContentWrapper variant="auto-width">
          <div>
            <Eyebrow variant="tag">SELECTED WORK</Eyebrow>
            <Heading tag="h2" variant="h2">
              Event Galleries
            </Heading>
          </div>
          <ButtonWrapper slot="column2">
            <Button
              element="link"
              href={matchedCategory ? `/galleries/category/${matchedCategory.slug}` : "/galleries"}
              emphasis="secondary"
            >
              {matchedCategory ? `${matchedCategory.shortName} Case Studies \u2192` : "View All Galleries \u2192"}
            </Button>
          </ButtonWrapper>
        </ContentWrapper>

        <Grid small={1} medium={3}>
          {matchedGalleries.map((item) => (
            <Card
              heading={item.title}
              text={`${item.subtitle} (${item.year})`}
              buttonHref={`/galleries/${item.slug}`}
              buttonLabel="View Case Study"
              image={item.posterImage}
              variant="stacked"
            />
          ))}
        </Grid>
      </Section>
    )
  }

  {
    planningGuides.length > 0 && (
      <Section paddingTop="medium" paddingBottom="medium">
        <ContentWrapper variant="auto-width">
          <div>
            <Eyebrow variant="tag">PLANNING GUIDES</Eyebrow>
            <Heading tag="h2" variant="h2">
              Plan the Assignment
            </Heading>
          </div>
          <ButtonWrapper slot="column2">
            <Button element="link" href="/docs" emphasis="secondary">
              All Docs and Guides &rarr;
            </Button>
          </ButtonWrapper>
        </ContentWrapper>

        <Grid small={1} medium={3}>
          {planningGuides.map((guide) => (
            <Card
              heading={guide.title}
              text={guide.summary}
              buttonHref={`/docs/${guide.slug}`}
              buttonLabel="Read Guide"
            />
          ))}
        </Grid>
      </Section>
    )
  }

  <!-- Sydney Coverage Hubs Cross-Link -->
  <Section paddingTop="medium" paddingBottom="medium">
    <ContentWrapper variant="auto-width">
      <div>
        <Eyebrow variant="tag">SYDNEY VENUES & REGIONS</Eyebrow>
        <Heading tag="h2" variant="h2"
          >Coverage Across Sydney Suburbs & Venues</Heading
        >
      </div>
      <ButtonWrapper slot="column2">
        <Button element="link" href="/locations" emphasis="secondary">
          All Locations &rarr;
        </Button>
      </ButtonWrapper>
    </ContentWrapper>

    <Grid small={1} medium={4}>
      {
        LOCATIONS.map((loc) => (
          <Card
            heading={loc.name}
            text={loc.tagline}
            buttonHref={`/locations/${loc.slug}`}
            buttonLabel={`View ${loc.name}`}
          />
        ))
      }
    </Grid>
  </Section>

  <!-- Booking CTA -->
  <Section paddingTop="medium" paddingBottom="large" theme="dark">
    <ContentWrapper centered={true}>
      <Eyebrow variant="tag">DISCUSS YOUR EVENT</Eyebrow>
      <Heading tag="h2" variant="h2" maxWidth={24}>Need a Photographer?</Heading
      >
      <Paragraph maxWidth={36}>
        Send your event date, location and photography needs for a quote.
      </Paragraph>
      <ButtonWrapper marginTop="4">
        <Button element="link" href="/pricing#pricing-builder">Estimate this coverage</Button>
        <Button
          element="link"
          href="/docs/event-briefing-template"
          variant="link"
        >
          View Briefing Guide
        </Button>
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
</Layout>

<style is:global>
  @layer components {
    .meta_line {
      display: block;
      margin-bottom: 0.35rem;
      line-height: 1.4;

      &:last-child {
        margin-bottom: 0;
      }
    }

    .deliverables-list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      padding-left: var(--space-4);
      margin-top: var(--space-4);
      color: var(--text);

      li {
        line-height: 1.5;
      }
    }
  }
</style>
